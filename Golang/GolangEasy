#!/usr/bin/env bash

CLR_RED='\033[0;31m'
CLR_GRN='\033[0;32m'
CLR_YLW='\033[1;33m'
CLR_BLU='\033[0;34m'
CLR_CYN='\033[0;36m'
CLR_ORG='\033[38;5;208m'
CLR_MUTED='\033[90m'
CLR_NC='\033[0m'

SCRIPT_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
REPO_RAW_URL="https://raw.githubusercontent.com/h4m1dr/app-folder/main/Golang"
CACHE_DIR="/tmp/app-folder-golang-cache"

if [ "$EUID" -ne 0 ]; then
    echo -e "${CLR_RED}[!] Please run as root (sudo).${CLR_NC}"
    exit 1
fi

# Ensure minimal system network certificates
ensure_runtime_dependencies() {
    if ! command -v curl &>/dev/null || ! [ -d "/etc/ssl/certs" ]; then
        apt-get update -y >/dev/null 2>&1
        apt-get install -y curl ca-certificates tar >/dev/null 2>&1
    fi
}
ensure_runtime_dependencies

get_go_bin() {
    if command -v go &>/dev/null; then
        command -v go
    elif [ -x "/usr/local/go/bin/go" ]; then
        echo "/usr/local/go/bin/go"
    fi
}

get_go_version_status() {
    local b
    b=$(get_go_bin)
    if [ -n "$b" ]; then
        local v
        v=$("$b" version 2>/dev/null | awk '{print $3}')
        echo -e "${CLR_GRN}${v:-Installed}${CLR_NC}"
    else
        echo -e "${CLR_MUTED}Not Installed (Not needed for compiled apps)${CLR_NC}"
    fi
}

go_menu() {
    while true; do
        clear
        echo "======================================"
        echo "       Go Compiler Engine Setup       "
        echo "======================================"
        echo -e " ${CLR_YLW}Note:${CLR_NC} Go runtime is ${CLR_GRN}NOT required${CLR_NC} for apps"
        echo -e " like Authelia or CLIProxyAPI (Native Binaries)."
        echo -e " Only install if you intend to compile Go code."
        echo "--------------------------------------"
        local b
        b=$(get_go_bin)
        if [ -n "$b" ]; then
            echo -e " Status      : ${CLR_GRN}Installed${CLR_NC}"
            echo -e " Version     : $(get_go_version_status)"
            echo -e " Binary Path : ${CLR_BLU}$b${CLR_NC}"
        else
            echo -e " Status      : ${CLR_MUTED}Not Installed${CLR_NC}"
        fi
        echo "--------------------------------------"
        echo " 1) Install Minimal Go (Official Archive)"
        echo " 2) Update Go to Latest"
        echo " 3) Remove Go Compiler"
        echo ""
        echo -e " ${CLR_ORG}b) Back${CLR_NC}"
        echo -e " ${CLR_RED}e) Exit${CLR_NC}"
        echo "--------------------------------------"
        read -p " Select option: " c
        case $c in
            1|2)
                echo -e "${CLR_BLU}[*] Checking latest release from go.dev...${CLR_NC}"
                local ver
                ver=$(curl -fsSL "https://go.dev/VERSION?m=text" 2>/dev/null | head -n 1)
                [ -z "$ver" ] && ver="go1.22.4"

                echo -e "${CLR_BLU}[*] Downloading minimal $ver archive...${CLR_NC}"
                curl -fsSL "https://go.dev/dl/${ver}.linux-amd64.tar.gz" -o /tmp/go.tar.gz
                
                rm -rf /usr/local/go
                tar -C /usr/local -xzf /tmp/go.tar.gz
                rm -f /tmp/go.tar.gz

                grep -q '/usr/local/go/bin' /etc/profile || echo 'export PATH=$PATH:/usr/local/go/bin' >> /etc/profile
                export PATH=$PATH:/usr/local/go/bin
                echo -e "${CLR_GRN}[+] Go ($ver) ready at /usr/local/go/bin/go.${CLR_NC}"
                read -p "Press Enter to continue..." ;;
            3)
                rm -rf /usr/local/go
                sed -i '/\/usr\/local\/go\/bin/d' /etc/profile
                echo -e "${CLR_GRN}[+] Go compiler removed completely.${CLR_NC}"
                read -p "Press Enter to continue..." ;;
            b|B) break ;;
            e|E) clear; exit 0 ;;
        esac
    done
}

wipe_menu() {
    while true; do
        clear
        echo "======================================"
        echo "           System Wipe Menu           "
        echo "======================================"
        echo " 1) Clean Go Build Caches"
        echo " 2) Purge Module & Temp Remnants"
        echo " 3) Wipe Remote Script Cache (/tmp)"
        echo " 4) Wipe Permanent Installation Folder"
        echo ""
        echo -e " ${CLR_ORG}b) Back${CLR_NC}"
        echo -e " ${CLR_RED}e) Exit${CLR_NC}"
        echo "--------------------------------------"
        read -p " Select option: " c
        case $c in
            1)
                local b
                b=$(get_go_bin)
                [ -n "$b" ] && "$b" clean -cache 2>/dev/null
                rm -rf /tmp/go-build* 2>/dev/null
                echo -e "${CLR_GRN}[+] Build cache wiped.${CLR_NC}"
                read -p "Press Enter to continue..." ;;
            2)
                local b
                b=$(get_go_bin)
                [ -n "$b" ] && "$b" clean -cache -modcache 2>/dev/null
                rm -rf /root/go/pkg /tmp/authelia* /tmp/cliproxyapi* /tmp/go* 2>/dev/null
                apt-get clean -y >/dev/null 2>&1
                journalctl --vacuum-time=1d >/dev/null 2>&1
                echo -e "${CLR_GRN}[+] Deep remnants purged.${CLR_NC}"
                read -p "Press Enter to continue..." ;;
            3)
                rm -rf /tmp/app-folder*
                echo -e "${CLR_GRN}[+] Script runner caches removed.${CLR_NC}"
                read -p "Press Enter to continue..." ;;
            4)
                read -p " Remove /opt/app-folder/Golang completely? [y/N]: " confirm
                if [[ "$confirm" =~ ^[yY]$ ]]; then
                    rm -rf /opt/app-folder/Golang /usr/local/bin/golang-easy
                    echo -e "${CLR_GRN}[+] Directory and symlink wiped.${CLR_NC}"
                    exit 0
                fi ;;
            b|B) break ;;
            e|E) clear; exit 0 ;;
        esac
    done
}

sync_modules() {
    local target_dir="$SCRIPT_DIR"
    if [ ! -f "$target_dir/authelia.sh" ] && [ ! -f "$target_dir/cliproxyapi.sh" ]; then
        target_dir="$CACHE_DIR"
        mkdir -p "$CACHE_DIR"
        for app in "authelia.sh" "cliproxyapi.sh"; do
            [ ! -f "$CACHE_DIR/$app" ] && curl -fsSL "$REPO_RAW_URL/$app" -o "$CACHE_DIR/$app" 2>/dev/null
        done
    fi
    echo "$target_dir"
}

ACTIVE_MODULE_DIR=$(sync_modules)

while true; do
    clear
    echo "======================================"
    echo "          GolangEasy Manager          "
    echo "======================================"
    echo -e " Compiler      : $(get_go_version_status)"
    echo "--------------------------------------"
    echo -e " 1) Golang Engine ${CLR_MUTED}(Optional/Dev Only)${CLR_NC}"

    installed_apps=()
    uninstalled_apps=()

    # 1. Authelia Check
    if [ -f "/etc/systemd/system/authelia.service" ] && [ -f "/usr/local/bin/authelia" ]; then
        installed_apps+=("authelia:$ACTIVE_MODULE_DIR/authelia.sh")
    else
        uninstalled_apps+=("authelia:$ACTIVE_MODULE_DIR/authelia.sh")
    fi

    # 2. CLIProxyAPI Check
    if [ -f "/etc/systemd/system/cliproxyapi.service" ] && [ -f "/usr/local/bin/cliproxyapi" ]; then
        installed_apps+=("cliproxyapi:$ACTIVE_MODULE_DIR/cliproxyapi.sh")
    else
        uninstalled_apps+=("cliproxyapi:$ACTIVE_MODULE_DIR/cliproxyapi.sh")
    fi

    idx=2
    for item in "${installed_apps[@]}"; do
        app_name="${item%%:*}"
        echo " $idx) $app_name"
        ((idx++))
    done

    others_idx=$idx
    echo " $others_idx) others"
    ((idx++))

    wipe_idx=$idx
    echo " $wipe_idx) wipe"
    echo ""
    echo -e " ${CLR_RED}e) Exit${CLR_NC}"
    echo "======================================"
    read -p " Select option: " choice

    if [ "$choice" == "1" ]; then
        go_menu
    elif [[ "$choice" =~ ^[0-9]+$ ]] && [ "$choice" -ge 2 ] && [ "$choice" -lt "$others_idx" ]; then
        target_item="${installed_apps[$((choice - 2))]}"
        bash "${target_item##*:}"
    elif [ "$choice" == "$others_idx" ]; then
        while true; do
            clear
            echo "======================================"
            echo "          Available Apps (Others)     "
            echo "======================================"
            if [ ${#uninstalled_apps[@]} -eq 0 ]; then
                echo " (All apps installed)"
                echo "--------------------------------------"
                echo -e " ${CLR_ORG}b) Back${CLR_NC}"
                read -p " Select option: " oc
                break
            fi
            oidx=1
            for u in "${uninstalled_apps[@]}"; do
                echo " $oidx) ${u%%:*}"
                ((oidx++))
            done
            echo ""
            echo -e " ${CLR_ORG}b) Back${CLR_NC}"
            echo "--------------------------------------"
            read -p " Select option: " oc
            if [[ "$oc" =~ ^[0-9]+$ ]] && [ "$oc" -ge 1 ] && [ "$oc" -le ${#uninstalled_apps[@]} ]; then
                target_item="${uninstalled_apps[$((oc - 1))]}"
                bash "${target_item##*:}"
                break
            elif [[ "$oc" =~ ^[bB]$ ]]; then
                break
            fi
        done
    elif [ "$choice" == "$wipe_idx" ]; then
        wipe_menu
    elif [[ "$choice" =~ ^[eE]$ ]]; then
        clear
        exit 0
    fi
done
