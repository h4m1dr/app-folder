#!/usr/bin/env bash

CLR_RED='\033[0;31m'
CLR_GRN='\033[0;32m'
CLR_YLW='\033[1;33m'
CLR_BLU='\033[0;34m'
CLR_CYN='\033[0;36m'
CLR_ORG='\033[38;5;208m'
CLR_MUTED='\033[90m'
CLR_NC='\033[0m'

SCRIPT_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
REPO_RAW_URL="https://raw.githubusercontent.com/h4m1dr/app-folder/main/Node-js"
CACHE_DIR="/tmp/app-folder-cache"
PERM_DIR="/opt/app-folder/Node-js"

KNOWN_APPS=("9router.sh")

if [ "$EUID" -ne 0 ]; then
    echo -e "${CLR_RED}[!] Please run as root (sudo).${CLR_NC}"
    exit 1
fi

ensure_system_deps() {
    [ -f "/usr/lib/x86_64-linux-gnu/libatomic.so.1" ] || [ -f "/usr/lib/libatomic.so.1" ] && return 0
    echo -e "${CLR_BLU}[*] Resolving runtime dependencies (libatomic1)...${CLR_NC}"
    apt-get update -y > /dev/null 2>&1
    apt-get install -y libatomic1 > /dev/null 2>&1
}
ensure_system_deps

is_node_installed() {
    command -v node &> /dev/null && return 0
    return 1
}

# ================= One-Time Initialization (No Loop Lag) =================
TARGET_NODE_VER=""
TARGET_NPM_VER=""

init_runtime_metadata() {
    echo -e "${CLR_MUTED}[*] Checking target updates for your system environment...${CLR_NC}"

    # Load NVM once if available
    if [ -s "$HOME/.nvm/nvm.sh" ]; then
        source "$HOME/.nvm/nvm.sh" 2>/dev/null
        TARGET_NODE_VER=$(nvm version-remote --lts 2>/dev/null)
    fi

    # Fallback if offline or NVM wasn't found
    local cur_node
    cur_node=$(node -v 2>/dev/null)
    [ -z "$TARGET_NODE_VER" ] || [ "$TARGET_NODE_VER" == "N/A" ] && TARGET_NODE_VER="$cur_node"

    # Query matching NPM target release once
    if command -v npm &> /dev/null; then
        TARGET_NPM_VER=$(npm view npm version 2>/dev/null)
        [ -z "$TARGET_NPM_VER" ] && TARGET_NPM_VER=$(npm -v 2>/dev/null)
    fi
}

get_node_version_status() {
    if is_node_installed; then
        local cur_v
        cur_v=$(node -v 2>/dev/null)
        if [ -n "$TARGET_NODE_VER" ] && [ "$cur_v" != "$TARGET_NODE_VER" ]; then
            echo -e "${CLR_YLW}$cur_v ${CLR_MUTED}-> ${CLR_GRN}$TARGET_NODE_VER${CLR_NC}"
        else
            echo -e "${CLR_GRN}$cur_v ${CLR_MUTED}(latest)${CLR_NC}"
        fi
    else
        echo -e "${CLR_RED}Not Installed${CLR_NC}"
    fi
}

get_npm_version_status() {
    if command -v npm &> /dev/null; then
        local cur_npm
        cur_npm=$(npm -v 2>/dev/null)
        if [ -n "$TARGET_NPM_VER" ] && [ "$cur_npm" != "$TARGET_NPM_VER" ]; then
            echo -e "${CLR_YLW}$cur_npm ${CLR_MUTED}-> ${CLR_GRN}$TARGET_NPM_VER${CLR_NC}"
        else
            echo -e "${CLR_GRN}$cur_npm ${CLR_MUTED}(latest)${CLR_NC}"
        fi
    else
        echo -e "${CLR_RED}Not Installed${CLR_NC}"
    fi
}

# ================= Node.js Engine =================
node_install() {
    if is_node_installed; then
        echo -e "${CLR_GRN}[+] Node.js is already installed at: $(which node)${CLR_NC}"
        return
    fi
    echo -e "${CLR_BLU}[*] Setting up official NodeSource repository (LTS)...${CLR_NC}"
    apt-get update -y && apt-get install -y ca-certificates curl gnupg libatomic1
    mkdir -p /etc/apt/keyrings
    curl -fsSL https://deb.nodesource.com/gpgkey/nodesource-repo.gpg.key | gpg --dearmor -o /etc/apt/keyrings/nodesource.gpg --yes
    echo "deb [signed-by=/etc/apt/keyrings/nodesource.gpg] https://deb.nodesource.com/node_20.x nodistro main" | tee /etc/apt/sources.list.d/nodesource.list
    apt-get update -y && apt-get install -y nodejs
    init_runtime_metadata
    echo -e "${CLR_GRN}[+] Node.js installed successfully.${CLR_NC}"
}

node_update() {
    echo -e "${CLR_BLU}[*] Checking and updating Node.js & NPM...${CLR_NC}"
    if [ -s "$HOME/.nvm/nvm.sh" ]; then
        echo -e "${CLR_BLU}[*] Detected NVM environment. Syncing and persisting LTS...${CLR_NC}"
        source "$HOME/.nvm/nvm.sh"
        nvm install --lts --reinstall-packages-from=current 2>/dev/null || true
        local new_ver
        new_ver=$(nvm current 2>/dev/null)
        if [ -n "$new_ver" ] && [ "$new_ver" != "none" ]; then
            nvm alias default "$new_ver" >/dev/null 2>&1
            nvm use default >/dev/null 2>&1
        fi
    elif dpkg -l 2>/dev/null | grep -q "^ii.*nodejs"; then
        echo -e "${CLR_BLU}[*] Updating via APT repository...${CLR_NC}"
        apt-get update -y && apt-get --only-upgrade install -y nodejs
    fi

    npm install -g npm@latest
    init_runtime_metadata
    echo -e "${CLR_GRN}[+] Active Node: $(which node) ($(node -v))${CLR_NC}"
    echo -e "${CLR_GRN}[+] Active NPM:  $(which npm) ($(npm -v))${CLR_NC}"
}

node_delete() {
    echo -e "${CLR_YLW}[!] Purging Node.js and global packages...${CLR_NC}"
    apt-get purge -y nodejs npm 2>/dev/null
    apt-get autoremove -y 2>/dev/null
    rm -f /etc/apt/sources.list.d/nodesource.list /etc/apt/keyrings/nodesource.gpg
    rm -rf /root/.npm /root/.node-gyp /usr/local/lib/node_modules /usr/lib/node_modules
    init_runtime_metadata
    echo -e "${CLR_GRN}[+] Node.js removed.${CLR_NC}"
}

node_menu() {
    while true; do
        clear
        echo "======================================"
        echo "          Node.js Engine Menu         "
        echo "======================================"
        if is_node_installed; then
            echo -e " Node Version: $(get_node_version_status)"
            echo -e " NPM Version : $(get_npm_version_status)"
            echo -e " Binary Path : ${CLR_BLU}$(which node)${CLR_NC}"
            echo -e " NPM Global  : ${CLR_BLU}$(npm root -g 2>/dev/null)${CLR_NC}"
        else
            echo -e " Status      : ${CLR_RED}Not Installed${CLR_NC}"
        fi
        echo "--------------------------------------"
        echo " 1) Install Node.js"
        echo " 2) Update Node.js & NPM"
        echo " 3) Delete Node.js"
        echo ""
        echo -e " ${CLR_ORG}b) Back${CLR_NC}"
        echo -e " ${CLR_RED}e) Exit${CLR_NC}"
        echo "--------------------------------------"
        read -p " Select option: " choice
        case $choice in
            1) node_install; read -p "Press Enter to continue..." ;;
            2) node_update; read -p "Press Enter to continue..." ;;
            3) node_delete; read -p "Press Enter to continue..." ;;
            b|B) break ;;
            e|E) clear; exit 0 ;;
            *) ;;
        esac
    done
}

# ================= Wipe Sub-Menu =================
wipe_simple() {
    echo -e "${CLR_BLU}[*] Running Simple Cache Wipe...${CLR_NC}"
    npm cache clean --force 2>/dev/null
    rm -rf /root/.npm/_cacache /root/.node-gyp 2>/dev/null
    echo -e "${CLR_GRN}[+] Standard package manager caches wiped.${CLR_NC}"
}

wipe_deep() {
    echo -e "${CLR_BLU}[*] Running Deep System & Residual Wipe...${CLR_NC}"
    npm cache clean --force 2>/dev/null
    rm -rf /root/.npm /root/.node-gyp /tmp/npm* /tmp/v8* 2>/dev/null
    apt-get clean -y >/dev/null 2>&1
    apt-get autoremove --purge -y >/dev/null 2>&1
    journalctl --vacuum-time=1d >/dev/null 2>&1
    echo -e "${CLR_GRN}[+] Deep post-install residual files and build caches wiped.${CLR_NC}"
}

wipe_cache_folder() {
    echo -e "${CLR_BLU}[*] Removing remote runner script cache ($CACHE_DIR)...${CLR_NC}"
    rm -rf "$CACHE_DIR"
    echo -e "${CLR_GRN}[+] Script runner cache directory removed.${CLR_NC}"
}

wipe_permanent_folder() {
    echo -e "${CLR_RED}[!] Warning: This will delete permanent repository directory (/opt/app-folder).${CLR_NC}"
    read -p " Are you sure you want to delete permanent folder? [y/N]: " confirm
    if [[ "$confirm" =~ ^[yY]$ ]]; then
        rm -rf /opt/app-folder
        rm -f /usr/local/bin/nodejs-easy
        echo -e "${CLR_GRN}[+] Permanent application files and system symlink wiped.${CLR_NC}"
    else
        echo -e "${CLR_YLW}[*] Operation aborted.${CLR_NC}"
    fi
}

wipe_menu() {
    while true; do
        clear
        echo "======================================"
        echo "           System Wipe Menu           "
        echo "======================================"
        echo -e " 1) Simple Cache Wipe"
        echo -e "    ${CLR_MUTED}(Cleans standard NPM and package download caches)${CLR_NC}"
        echo ""
        echo -e " 2) Deep Residual Wipe"
        echo -e "    ${CLR_MUTED}(Purges leftover build junk, apt caches, and journal logs)${CLR_NC}"
        echo ""
        echo -e " 3) Wipe Remote Script Cache"
        echo -e "    ${CLR_MUTED}(Deletes temporary runner folder: /tmp/app-folder-cache)${CLR_NC}"
        echo ""
        echo -e " 4) Wipe Permanent Application Folder"
        echo -e "    ${CLR_MUTED}(Deletes /opt/app-folder and global binary links)${CLR_NC}"
        echo ""
        echo -e " ${CLR_ORG}b) Back${CLR_NC}"
        echo -e " ${CLR_RED}e) Exit${CLR_NC}"
        echo "--------------------------------------"
        read -p " Select option: " choice
        case $choice in
            1) wipe_simple; read -p "Press Enter to continue..." ;;
            2) wipe_deep; read -p "Press Enter to continue..." ;;
            3) wipe_cache_folder; read -p "Press Enter to continue..." ;;
            4) wipe_permanent_folder; read -p "Press Enter to continue..." ;;
            b|B) break ;;
            e|E) clear; exit 0 ;;
            *) ;;
        esac
    done
}

# ================= Self-Updater =================
self_update() {
    echo -e "${CLR_BLU}[*] Reinstalling and updating scripts from GitHub...${CLR_NC}"
    rm -rf "$CACHE_DIR"

    if [ -d "$PERM_DIR" ] && [ -f "$PERM_DIR/NodejsEasy" ]; then
        curl -fsSL "$REPO_RAW_URL/NodejsEasy" -o "$PERM_DIR/NodejsEasy"
        curl -fsSL "$REPO_RAW_URL/9router.sh" -o "$PERM_DIR/9router.sh"
        chmod +x "$PERM_DIR/NodejsEasy" "$PERM_DIR"/*.sh
        echo -e "${CLR_GRN}[+] Permanent installation files updated.${CLR_NC}"
        exec "$PERM_DIR/NodejsEasy"
    else
        mkdir -p "$CACHE_DIR"
        curl -fsSL "$REPO_RAW_URL/NodejsEasy" -o "$CACHE_DIR/NodejsEasy"
        curl -fsSL "$REPO_RAW_URL/9router.sh" -o "$CACHE_DIR/9router.sh"
        chmod +x "$CACHE_DIR/NodejsEasy" "$CACHE_DIR"/*.sh
        echo -e "${CLR_GRN}[+] Runner scripts updated.${CLR_NC}"
        exec bash "$CACHE_DIR/NodejsEasy"
    fi
}

# ================= Others Sub-Menu =================
others_menu() {
    local uninstalled_files=("$@")
    while true; do
        clear
        echo "======================================"
        echo "          Available Apps (Others)     "
        echo "======================================"
        if [ ${#uninstalled_files[@]} -eq 0 ]; then
            echo " (No uninstalled apps found)"
            echo "--------------------------------------"
            echo -e " ${CLR_ORG}b) Back${CLR_NC}"
            echo -e " ${CLR_RED}e) Exit${CLR_NC}"
            read -p " Select option: " choice
            [[ "$choice" =~ ^[bB]$ ]] && break
            [[ "$choice" =~ ^[eE]$ ]] && { clear; exit 0; }
            continue
        fi

        local idx=1
        for f in "${uninstalled_files[@]}"; do
            local base_name
            base_name=$(basename "$f" .sh)
            echo " $idx) $base_name"
            ((idx++))
        done
        echo ""
        echo -e " ${CLR_ORG}b) Back${CLR_NC}"
        echo -e " ${CLR_RED}e) Exit${CLR_NC}"
        echo "--------------------------------------"
        read -p " Select option: " choice

        if [[ "$choice" =~ ^[0-9]+$ ]] && [ "$choice" -ge 1 ] && [ "$choice" -le ${#uninstalled_files[@]} ]; then
            local selected_file="${uninstalled_files[$((choice - 1))]}"
            if [ -f "$selected_file" ]; then
                source "$selected_file"
                if declare -f app_menu > /dev/null; then
                    app_menu
                    break
                fi
            fi
        elif [[ "$choice" =~ ^[bB]$ ]]; then
            break
        elif [[ "$choice" =~ ^[eE]$ ]]; then
            clear
            exit 0
        fi
    done
}

# ================= Dynamic Main Menu =================
main_menu() {
    # 1. Fetch remote version metadata once at launch
    init_runtime_metadata

    # 2. Discover local or cached module scripts once
    local target_scripts=()
    for f in "$SCRIPT_DIR"/*.sh; do
        [ -f "$f" ] && target_scripts+=("$f")
    done

    if [ ${#target_scripts[@]} -eq 0 ]; then
        mkdir -p "$CACHE_DIR"
        for app_script in "${KNOWN_APPS[@]}"; do
            [ ! -f "$CACHE_DIR/$app_script" ] && curl -fsSL "$REPO_RAW_URL/$app_script" -o "$CACHE_DIR/$app_script" 2>/dev/null
            [ -f "$CACHE_DIR/$app_script" ] && target_scripts+=("$CACHE_DIR/$app_script")
        done
    fi

    # Initialize sub-modules once if they support metadata gathering
    for f in "${target_scripts[@]}"; do
        if [ -f "$f" ]; then
            source "$f"
            declare -f app_init_metadata > /dev/null && app_init_metadata
        fi
    done

    # 3. Pure UI rendering loop (zero network requests, instantaneous redraw)
    while true; do
        clear
        echo "======================================"
        echo "          NodejsEasy Manager          "
        echo "======================================"
        echo -e " Node Version  : $(get_node_version_status)"
        echo -e " NPM Version   : $(get_npm_version_status)"
        echo "--------------------------------------"
        echo " 1) Node js"

        local installed_files=()
        local uninstalled_files=()

        for f in "${target_scripts[@]}"; do
            if [ -f "$f" ]; then
                source "$f"
                if declare -f app_is_installed > /dev/null && app_is_installed; then
                    installed_files+=("$f")
                else
                    uninstalled_files+=("$f")
                fi
            fi
        done

        local idx=2
        for f in "${installed_files[@]}"; do
            local base_name
            base_name=$(basename "$f" .sh)
            echo " $idx) $base_name"
            ((idx++))
        done

        local others_idx=$idx
        echo " $others_idx) others"
        ((idx++))

        local wipe_idx=$idx
        echo " $wipe_idx) wipe"
        echo ""
        echo -e " ${CLR_CYN}i) Self-Update & Reinstall${CLR_NC}"
        echo -e " ${CLR_RED}e) Exit${CLR_NC}"
        echo "======================================"
        read -p " Select option: " choice

        if [[ "$choice" =~ ^[0-9]+$ ]]; then
            if [ "$choice" -eq 1 ]; then
                node_menu
            elif [ "$choice" -ge 2 ] && [ "$choice" -lt "$others_idx" ]; then
                local selected_file="${installed_files[$((choice - 2))]}"
                if [ -f "$selected_file" ]; then
                    source "$selected_file"
                    if declare -f app_menu > /dev/null; then
                        app_menu
                    fi
                fi
            elif [ "$choice" -eq "$others_idx" ]; then
                others_menu "${uninstalled_files[@]}"
            elif [ "$choice" -eq "$wipe_idx" ]; then
                wipe_menu
            fi
        elif [[ "$choice" =~ ^[iI]$ ]]; then
            self_update
        elif [[ "$choice" =~ ^[eE]$ ]]; then
            clear
            exit 0
        fi
    done
}

main_menu
