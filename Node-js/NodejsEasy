#!/usr/bin/env bash

# Color codes
RED='\033[0;31m'
GREEN='\033[0;32m'
YELLOW='\033[1;33m'
BLUE='\033[0;34m'
NC='\033[0m'

SCRIPT_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"

if [ "$EUID" -ne 0 ]; then
    echo -e "${RED}[!] Please run as root (sudo).${NC}"
    exit 1
fi

# Simple check for main menu header (only checks if installed or not)
is_node_installed() {
    if command -v node &> /dev/null; then
        return 0
    fi
    return 1
}

# ================= Node.js Engine =================
node_install() {
    if is_node_installed; then
        echo -e "${GREEN}[+] Node.js is already installed at: $(which node)${NC}"
        return
    fi
    echo -e "${BLUE}[*] Setting up Node.js repository (LTS)...${NC}"
    apt-get update -y && apt-get install -y ca-certificates curl gnupg
    mkdir -p /etc/apt/keyrings
    curl -fsSL https://deb.nodesource.com/gpgkey/nodesource-repo.gpg.key | gpg --dearmor -o /etc/apt/keyrings/nodesource.gpg --yes
    echo "deb [signed-by=/etc/apt/keyrings/nodesource.gpg] https://deb.nodesource.com/node_20.x nodistro main" | tee /etc/apt/sources.list.d/nodesource.list
    apt-get update -y && apt-get install -y nodejs
    echo -e "${GREEN}[+] Node.js installed successfully.${NC}"
}

node_update() {
    echo -e "${BLUE}[*] Updating Node.js & NPM...${NC}"
    apt-get update -y && apt-get --only-upgrade install -y nodejs
    npm install -g npm@latest
    echo -e "${GREEN}[+] Node.js: $(node -v)${NC}"
    echo -e "${GREEN}[+] NPM:     $(npm -v)${NC}"
}

node_delete() {
    echo -e "${YELLOW}[!] Purging Node.js and global packages...${NC}"
    apt-get purge -y nodejs npm
    apt-get autoremove -y
    rm -f /etc/apt/sources.list.d/nodesource.list /etc/apt/keyrings/nodesource.gpg
    rm -rf /root/.npm /root/.node-gyp /usr/local/lib/node_modules /usr/lib/node_modules
    echo -e "${GREEN}[+] Node.js removed.${NC}"
}

node_menu() {
    while true; do
        clear
        echo "======================================"
        echo "          Node.js Engine Menu         "
        echo "======================================"
        if is_node_installed; then
            echo -e " Version     : ${GREEN}$(node -v)${NC}"
            echo -e " Binary Path : ${BLUE}$(which node)${NC}"
            echo -e " NPM Global  : ${BLUE}$(npm root -g 2>/dev/null)${NC}"
        else
            echo -e " Status      : ${RED}Not Installed${NC}"
        fi
        echo "--------------------------------------"
        echo " 1) Install Node.js"
        echo " 2) Update Node.js & NPM"
        echo " 3) Delete Node.js"
        echo " b) Back"
        echo "--------------------------------------"
        read -p " Select option: " choice
        case $choice in
            1) node_install; read -p "Press Enter to continue..." ;;
            2) node_update; read -p "Press Enter to continue..." ;;
            3) node_delete; read -p "Press Enter to continue..." ;;
            b|B) break ;;
            *) sleep 1 ;;
        esac
    done
}

# ================= Others Sub-Menu =================
others_menu() {
    local uninstalled_files=("$@")
    while true; do
        clear
        echo "======================================"
        echo "          Available Apps (Others)     "
        echo "======================================"
        if [ ${#uninstalled_files[@]} -eq 0 ]; then
            echo " (No uninstalled apps found)"
            echo "--------------------------------------"
            echo " b) Back"
            read -p " Select option: " choice
            break
        fi

        local idx=1
        for f in "${uninstalled_files[@]}"; do
            local base_name
            base_name=$(basename "$f" .sh)
            echo " $idx) $base_name"
            ((idx++))
        done
        echo " b) Back"
        echo "--------------------------------------"
        read -p " Select option: " choice

        if [[ "$choice" =~ ^[0-9]+$ ]] && [ "$choice" -ge 1 ] && [ "$choice" -le ${#uninstalled_files[@]} ]; then
            local selected_file="${uninstalled_files[$((choice - 1))]}"
            if [ -f "$selected_file" ]; then
                source "$selected_file"
                if declare -f app_menu > /dev/null; then
                    app_menu
                    break # Break back to refresh status in main menu
                fi
            fi
        elif [[ "$choice" =~ ^[bB]$ ]]; then
            break
        fi
    done
}

# ================= Smart Wiper =================
smart_wipe() {
    echo -e "${BLUE}[*] Scanning residual caches & junk...${NC}"
    local wipe_items=()
    local clean_npm=0
    local clean_deb=0
    local clean_logs=0

    if [ -d "/root/.npm" ] && [ "$(du -s /root/.npm 2>/dev/null | cut -f1)" -gt 1024 ]; then
        wipe_items+=("NPM Cache ($(du -sh /root/.npm 2>/dev/null | cut -f1))")
        clean_npm=1
    fi

    local DEB_COUNT
    DEB_COUNT=$(find /var/cache/apt/archives -type f -name '*.deb' 2>/dev/null | wc -l)
    if [ "$DEB_COUNT" -gt 0 ]; then
        wipe_items+=("APT Cached packages ($DEB_COUNT files)")
        clean_deb=1
    fi

    local LOG_SZ
    LOG_SZ=$(journalctl --disk-usage 2>/dev/null | grep -o '[0-9\.]\+[KMG]')
    if [ -n "$LOG_SZ" ]; then
        wipe_items+=("Systemd Logs ($LOG_SZ, vacuum to 2d)")
        clean_logs=1
    fi

    if [ ${#wipe_items[@]} -eq 0 ]; then
        echo -e "${GREEN}[+] Everything is clean. Nothing to wipe.${NC}"
        return
    fi

    echo -e "${YELLOW}Pending cleanup items:${NC}"
    for itm in "${wipe_items[@]}"; do
        echo -e " - $itm"
    done

    echo -e "${BLUE}[*] Wiping...${NC}"
    [ "$clean_npm" -eq 1 ] && { npm cache clean --force 2>/dev/null; rm -rf /root/.npm /root/.node-gyp; }
    [ "$clean_deb" -eq 1 ] && { apt-get clean -y; apt-get autoremove --purge -y; }
    [ "$clean_logs" -eq 1 ] && journalctl --vacuum-time=2d >/dev/null 2>&1

    echo -e "${GREEN}[+] Cleanup complete!${NC}"
}

# ================= Dynamic Main Menu =================
main_menu() {
    while true; do
        clear
        echo "======================================"
        echo "          NodejsEasy Manager          "
        echo "======================================"
        if is_node_installed; then
            echo -e " Node.js State : ${GREEN}Installed ($(node -v))${NC}"
        else
            echo -e " Node.js State : ${RED}Not Installed${NC}"
        fi
        echo "--------------------------------------"
        echo " 1) Node js"

        # Categorize apps into Installed vs Others (Instant local check)
        local installed_files=()
        local uninstalled_files=()

        for f in "$SCRIPT_DIR"/*.sh; do
            if [ -f "$f" ]; then
                # Load script check function
                source "$f"
                if declare -f app_is_installed > /dev/null && app_is_installed; then
                    installed_files+=("$f")
                else
                    uninstalled_files+=("$f")
                fi
            fi
        done

        # Render installed apps directly on main menu
        local idx=2
        for f in "${installed_files[@]}"; do
            local base_name
            base_name=$(basename "$f" .sh)
            echo " $idx) $base_name"
            ((idx++))
        done

        local others_idx=$idx
        echo " $others_idx) others"
        ((idx++))

        local wipe_idx=$idx
        echo " $wipe_idx) wipe"
        echo " e) Exit"
        echo "======================================"
        read -p " Select option: " choice

        if [[ "$choice" =~ ^[0-9]+$ ]]; then
            if [ "$choice" -eq 1 ]; then
                node_menu
            elif [ "$choice" -ge 2 ] && [ "$choice" -lt "$others_idx" ]; then
                local selected_file="${installed_files[$((choice - 2))]}"
                if [ -f "$selected_file" ]; then
                    source "$selected_file"
                    if declare -f app_menu > /dev/null; then
                        app_menu
                    fi
                fi
            elif [ "$choice" -eq "$others_idx" ]; then
                others_menu "${uninstalled_files[@]}"
            elif [ "$choice" -eq "$wipe_idx" ]; then
                smart_wipe
                read -p "Press Enter to continue..."
            fi
        elif [[ "$choice" =~ ^[eE]$ ]]; then
            clear
            exit 0
        fi
    done
}

main_menu
